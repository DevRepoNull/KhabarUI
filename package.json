{
  "name": "rasad-news-template",
  "version": "1.0.0",
  "private": true,
  "description": "Rasad Persian News Agency & CMS Template - Local Tailwind CSS Build System",
  "scripts": {
    "watch": "tailwindcss -i ./src/input.css -o ./assets/css/style.css --watch",
