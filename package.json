    "build": "tailwindcss -i ./src/input.css -o ./assets/css/style.css --minify"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0"
  },
  "dependencies": {
    "@majidh1/jalalidatepicker": "^1.0.0",
    "just-validate": "^4.3.0"
  }
}
